{
  "interface_version": 2,
  "name": "wechat_channels",
  "label": "$project_name",
  "version": "0.12.0",
  "description": "$project_description",
  "languages": {
    "zh_cn": "locale/zh_cn.json",
    "en_us": "locale/en_us.json"
  },
  "controller": [
    {
      "name": "Android",
      "type": "Adb",
      "display_short_side": 720
    }
  ],
  "resource": [
    {
      "name": "base",
      "label": "$resource_name",
      "path": [
        "resource/base"
      ]
    }
  ],
  "task": [
    {
      "name": "collect_channels",
      "label": "$collect_channels_name",
      "description": "$collect_channels_description",
      "entry": "CollectWechatChannels",
      "default_check": true,
      "option": [
        "collect_entry",
        "collect_count",
        "collect_video_filter",
        "collect_comment_filter"
      ],
      "pipeline_override": {
        "CollectWechatChannels": {
          "custom_action_param": {
            "entry": "recommend",
            "count": 10
          }
        }
      }
    },
    {
      "name": "link_like_comment",
      "label": "$link_like_comment_name",
      "description": "$link_like_comment_description",
      "entry": "WechatLinkLikeComment",
      "default_check": false,
      "option": [
        "link_like_comment_input"
      ],
      "pipeline_override": {
        "WechatLinkLikeComment": {
          "custom_action_param": {
            "action": "likeComment"
          }
        }
      }
    },
    {
      "name": "link_reply_comment",
      "label": "$link_reply_comment_name",
      "description": "$link_reply_comment_description",
      "entry": "WechatLinkReplyComment",
      "default_check": false,
      "option": [
        "link_reply_comment_input"
      ],
      "pipeline_override": {
        "WechatLinkReplyComment": {
          "custom_action_param": {
            "action": "replyComment"
          }
        }
      }
    },
    {
      "name": "link_message_commenter",
      "label": "$link_message_commenter_name",
      "description": "$link_message_commenter_description",
      "entry": "WechatLinkMessageCommenter",
      "default_check": false,
      "option": [
        "link_message_commenter_input"
      ],
      "pipeline_override": {
        "WechatLinkMessageCommenter": {
          "custom_action_param": {
            "action": "messageCommenter"
          }
        }
      }
    },
    {
      "name": "inspect_messages",
      "label": "$inspect_messages_name",
      "description": "$inspect_messages_description",
      "entry": "InspectWechatMessages",
      "default_check": false,
      "option": [
        "messages_like",
        "messages_settings"
      ],
      "pipeline_override": {
        "InspectWechatMessages": {
          "custom_action_param": {
            "ensureFeed": true,
            "inspectMessages": {
              "like": true,
              "maxMessages": 1
            }
          }
        }
      }
    },
    {
      "name": "link_like_video",
      "label": "$link_like_video_name",
      "description": "$link_like_video_description",
      "entry": "WechatLinkLikeVideo",
      "default_check": false,
      "option": [
        "link_like_video_input"
      ],
      "pipeline_override": {
        "WechatLinkLikeVideo": {
          "custom_action_param": {
            "action": "likeVideo"
          }
        }
      }
    },
    {
      "name": "link_follow_author",
      "label": "$link_follow_author_name",
      "description": "$link_follow_author_description",
      "entry": "WechatLinkFollowAuthor",
      "default_check": false,
      "option": [
        "link_follow_author_input"
      ],
      "pipeline_override": {
        "WechatLinkFollowAuthor": {
          "custom_action_param": {
            "action": "followAuthor"
          }
        }
      }
    },
    {
      "name": "link_message_author",
      "label": "$link_message_author_name",
      "description": "$link_message_author_description",
      "entry": "WechatLinkMessageAuthor",
      "default_check": false,
      "option": [
        "link_message_author_input"
      ],
      "pipeline_override": {
        "WechatLinkMessageAuthor": {
          "custom_action_param": {
            "action": "messageAuthor"
          }
        }
      }
    },
    {
      "name": "link_comment_video",
      "label": "$link_comment_video_name",
      "description": "$link_comment_video_description",
      "entry": "WechatLinkCommentVideo",
      "default_check": false,
      "option": [
        "link_comment_video_input"
      ],
      "pipeline_override": {
        "WechatLinkCommentVideo": {
          "custom_action_param": {
            "action": "commentVideo"
          }
        }
      }
    }
  ],
  "option": {
    "collect_entry": {
      "type": "select",
      "label": "$collect_entry_label",
      "cases": [
        {
          "name": "recommend",
          "label": "$collect_entry_recommend",
          "pipeline_override": {
            "CollectWechatChannels": {
              "custom_action_param": {
                "entry": "recommend"
              }
            }
          }
        },
        {
          "name": "search",
          "label": "$collect_entry_search",
          "option": [
            "collect_keyword"
          ],
          "pipeline_override": {
            "CollectWechatChannels": {
              "custom_action_param": {
                "entry": "search"
              }
            }
          }
        },
        {
          "name": "city",
          "label": "$collect_entry_city",
          "pipeline_override": {
            "CollectWechatChannels": {
              "custom_action_param": {
                "entry": "city"
              }
            }
          }
        }
      ]
    },
    "collect_keyword": {
      "type": "input",
      "label": "$collect_keyword_label",
      "inputs": [
        {
          "name": "keyword",
          "label": "$collect_keyword_field",
          "default": "",
          "verify": "\\S",
          "pattern_msg": "$collect_keyword_required"
        }
      ],
      "pipeline_override": {
        "CollectWechatChannels": {
          "custom_action_param": {
            "keyword": "{keyword}"
          }
        }
      }
    },
    "collect_count": {
      "type": "input",
      "label": "$collect_count_label",
      "description": "$collect_count_description",
      "inputs": [
        {
          "name": "count",
          "label": "$collect_count_field",
          "default": "10",
          "pipeline_type": "int",
          "verify": "^(?:[1-9]\\d?|[1-4]\\d\\d|500)$",
          "pattern_msg": "$collect_count_invalid"
        }
      ],
      "pipeline_override": {
        "CollectWechatChannels": {
          "custom_action_param": {
            "count": "{count}"
          }
        }
      }
    },
    "collect_video_filter": {
      "type": "input",
      "label": "$collect_video_filter_label",
      "description": "$collect_video_filter_description",
      "inputs": [
        {
          "name": "words",
          "label": "$collect_video_filter_field",
          "default": ""
        }
      ],
      "pipeline_override": {
        "CollectWechatChannels": {
          "custom_action_param": {
            "videoFilter": "{words}"
          }
        }
      }
    },
    "collect_comment_filter": {
      "type": "input",
      "label": "$collect_comment_filter_label",
      "description": "$collect_comment_filter_description",
      "inputs": [
        {
          "name": "words",
          "label": "$collect_comment_filter_field",
          "default": ""
        }
      ],
      "pipeline_override": {
        "CollectWechatChannels": {
          "custom_action_param": {
            "commentFilter": "{words}"
          }
        }
      }
    },
    "link_like_comment_input": {
      "type": "input",
      "label": "$link_input_label",
      "inputs": [
        {
          "name": "link",
          "label": "$link_url_field",
          "placeholder": "$link_url_placeholder",
          "default": "",
          "verify": "https://(?:weixin\\.qq\\.com/sph/|channels\\.weixin\\.qq\\.com/)",
          "pattern_msg": "$link_url_invalid"
        },
        {
          "name": "nickname",
          "label": "$link_nickname_field",
          "default": "",
          "verify": "\\S",
          "pattern_msg": "$link_nickname_required"
        }
      ],
      "pipeline_override": {
        "WechatLinkLikeComment": {
          "custom_action_param": {
            "link": "{link}",
            "nickname": "{nickname}"
          }
        }
      }
    },
    "link_reply_comment_input": {
      "type": "input",
      "label": "$link_input_label",
      "inputs": [
        {
          "name": "link",
          "label": "$link_url_field",
          "placeholder": "$link_url_placeholder",
          "default": "",
          "verify": "https://(?:weixin\\.qq\\.com/sph/|channels\\.weixin\\.qq\\.com/)",
          "pattern_msg": "$link_url_invalid"
        },
        {
          "name": "nickname",
          "label": "$link_nickname_field",
          "default": "",
          "verify": "\\S",
          "pattern_msg": "$link_nickname_required"
        },
        {
          "name": "text",
          "label": "$link_reply_comment_text_field",
          "default": "",
          "verify": "\\S",
          "pattern_msg": "$link_text_required"
        }
      ],
      "pipeline_override": {
        "WechatLinkReplyComment": {
          "custom_action_param": {
            "link": "{link}",
            "nickname": "{nickname}",
            "text": "{text}"
          }
        }
      }
    },
    "link_message_commenter_input": {
      "type": "input",
      "label": "$link_input_label",
      "inputs": [
        {
          "name": "link",
          "label": "$link_url_field",
          "placeholder": "$link_url_placeholder",
          "default": "",
          "verify": "https://(?:weixin\\.qq\\.com/sph/|channels\\.weixin\\.qq\\.com/)",
          "pattern_msg": "$link_url_invalid"
        },
        {
          "name": "nickname",
          "label": "$link_nickname_field",
          "default": "",
          "verify": "\\S",
          "pattern_msg": "$link_nickname_required"
        },
        {
          "name": "text",
          "label": "$link_message_commenter_text_field",
          "default": "",
          "verify": "\\S",
          "pattern_msg": "$link_text_required"
        }
      ],
      "pipeline_override": {
        "WechatLinkMessageCommenter": {
          "custom_action_param": {
            "link": "{link}",
            "nickname": "{nickname}",
            "text": "{text}"
          }
        }
      }
    },
    "messages_like": {
      "type": "switch",
      "label": "$messages_like_label",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "InspectWechatMessages": {
              "custom_action_param": {
                "inspectMessages": {
                  "like": true
                }
              }
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "InspectWechatMessages": {
              "custom_action_param": {
                "inspectMessages": {
                  "like": false
                }
              }
            }
          }
        }
      ]
    },
    "messages_settings": {
      "type": "input",
      "label": "$messages_settings_label",
      "inputs": [
        {
          "name": "count",
          "label": "$messages_count_field",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^([1-9]|10)$"
        },
        {
          "name": "reply",
          "label": "$messages_reply_field",
          "description": "$messages_reply_description",
          "default": ""
        }
      ],
      "pipeline_override": {
        "InspectWechatMessages": {
          "custom_action_param": {
            "inspectMessages": {
              "maxMessages": "{count}",
              "replyText": "{reply}"
            }
          }
        }
      }
    },
    "link_like_video_input": {
      "type": "input",
      "label": "$link_input_label",
      "inputs": [
        {
          "name": "link",
          "label": "$link_url_field",
          "placeholder": "$link_url_placeholder",
          "default": "",
          "verify": "https://(?:weixin\\.qq\\.com/sph/|channels\\.weixin\\.qq\\.com/)",
          "pattern_msg": "$link_url_invalid"
        }
      ],
      "pipeline_override": {
        "WechatLinkLikeVideo": {
          "custom_action_param": {
            "link": "{link}"
          }
        }
      }
    },
    "link_follow_author_input": {
      "type": "input",
      "label": "$link_input_label",
      "inputs": [
        {
          "name": "link",
          "label": "$link_url_field",
          "placeholder": "$link_url_placeholder",
          "default": "",
          "verify": "https://(?:weixin\\.qq\\.com/sph/|channels\\.weixin\\.qq\\.com/)",
          "pattern_msg": "$link_url_invalid"
        }
      ],
      "pipeline_override": {
        "WechatLinkFollowAuthor": {
          "custom_action_param": {
            "link": "{link}"
          }
        }
      }
    },
    "link_message_author_input": {
      "type": "input",
      "label": "$link_input_label",
      "inputs": [
        {
          "name": "link",
          "label": "$link_url_field",
          "placeholder": "$link_url_placeholder",
          "default": "",
          "verify": "https://(?:weixin\\.qq\\.com/sph/|channels\\.weixin\\.qq\\.com/)",
          "pattern_msg": "$link_url_invalid"
        },
        {
          "name": "text",
          "label": "$link_message_author_text_field",
          "default": "",
          "verify": "\\S",
          "pattern_msg": "$link_text_required"
        }
      ],
      "pipeline_override": {
        "WechatLinkMessageAuthor": {
          "custom_action_param": {
            "link": "{link}",
            "text": "{text}"
          }
        }
      }
    },
    "link_comment_video_input": {
      "type": "input",
      "label": "$link_input_label",
      "inputs": [
        {
          "name": "link",
          "label": "$link_url_field",
          "placeholder": "$link_url_placeholder",
          "default": "",
          "verify": "https://(?:weixin\\.qq\\.com/sph/|channels\\.weixin\\.qq\\.com/)",
          "pattern_msg": "$link_url_invalid"
        },
        {
          "name": "text",
          "label": "$link_comment_video_text_field",
          "default": "",
          "verify": "\\S",
          "pattern_msg": "$link_text_required"
        }
      ],
      "pipeline_override": {
        "WechatLinkCommentVideo": {
          "custom_action_param": {
            "link": "{link}",
            "text": "{text}"
          }
        }
      }
    }
  },
  "preset": [
    {
      "name": "daily_collect",
      "label": "$preset_collect",
      "task": [
        {
          "name": "collect_channels"
        }
      ]
    }
  ],
  "agent": {
    "child_exec": "python3",
    "child_args": [
      "agent/main.py"
    ]
  }
}

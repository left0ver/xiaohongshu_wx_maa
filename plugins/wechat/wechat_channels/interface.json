{
  "interface_version": 2,
  "name": "wechat_channels",
  "label": "$project_name",
  "version": "0.10.0",
  "description": "$project_description",
  "languages": {
    "zh_cn": "locale/zh_cn.json",
    "en_us": "locale/en_us.json"
  },
  "controller": [
    {
      "name": "Android",
      "type": "Adb",
      "display_short_side": 720
    }
  ],
  "resource": [
    {
      "name": "base",
      "label": "$resource_name",
      "path": [
        "resource/base"
      ]
    }
  ],
  "task": [
    {
      "name": "collect_video",
      "label": "$collect_task_name",
      "description": "$collect_task_description",
      "entry": "CollectWechatVideo",
      "default_check": true
    },
    {
      "name": "collect_comments",
      "label": "$collect_comments_name",
      "description": "$collect_comments_description",
      "entry": "CollectWechatComments",
      "default_check": false,
      "option": [
        "collect_comments_unlimited",
        "collect_comments_limits"
      ]
    },
    {
      "name": "interact_work",
      "label": "$interact_work_name",
      "description": "$interact_work_description",
      "entry": "InteractWechatWork",
      "default_check": false,
      "pipeline_override": {
        "InteractWechatWork": {
          "custom_action_param": {
            "ensureFeed": true
          }
        }
      },
      "option": [
        "interact_work_actions",
        "interact_comment_actions",
        "interact_author_profile",
        "interact_messages",
        "interact_self_nickname"
      ]
    },
    {
      "name": "like_and_visit",
      "label": "$task_name",
      "description": "$task_description",
      "entry": "StartWeChat",
      "default_check": false
    },
    {
      "name": "open_wechat",
      "label": "$open_wechat_label",
      "description": "$open_wechat_description",
      "entry": "StartWeChat",
      "default_check": false,
      "pipeline_override": {
        "StartWeChat": {
          "next": []
        }
      }
    },
    {
      "name": "open_discover",
      "label": "$open_discover_label",
      "description": "$open_discover_description",
      "entry": "OpenDiscover",
      "default_check": false,
      "pipeline_override": {
        "OpenDiscover": {
          "next": [
            "DiscoverReady"
          ]
        }
      }
    },
    {
      "name": "open_channels",
      "label": "$open_channels_label",
      "description": "$open_channels_description",
      "entry": "OpenChannels",
      "default_check": false,
      "pipeline_override": {
        "OpenChannels": {
          "next": [
            "FeedReady"
          ]
        },
        "FeedReady": {
          "next": []
        }
      }
    },
    {
      "name": "open_author",
      "label": "$open_author_label",
      "description": "$open_author_description",
      "entry": "OpenVisibleAuthor",
      "default_check": false,
      "pipeline_override": {}
    },
    {
      "name": "open_author_video",
      "label": "$open_author_video_label",
      "description": "$open_author_video_description",
      "entry": "OpenAuthorVideo",
      "default_check": false,
      "pipeline_override": {}
    },
    {
      "name": "like_video",
      "label": "$like_video_label",
      "description": "$like_video_description",
      "entry": "LikeVideo",
      "default_check": false,
      "pipeline_override": {}
    },
    {
      "name": "return_to_author",
      "label": "$return_to_author_label",
      "description": "$return_to_author_description",
      "entry": "ReturnToAuthor",
      "default_check": false,
      "pipeline_override": {}
    },
    {
      "name": "return_to_feed",
      "label": "$return_to_feed_label",
      "description": "$return_to_feed_description",
      "entry": "ReturnToFeed",
      "default_check": false,
      "pipeline_override": {
        "ReturnToFeed": {
          "next": [
            "FeedReady"
          ]
        },
        "FeedReady": {
          "next": []
        }
      }
    },
    {
      "name": "open_personal",
      "label": "$open_personal_label",
      "description": "$open_personal_description",
      "entry": "OpenPersonal",
      "default_check": false,
      "pipeline_override": {
        "OpenPersonal": {
          "all_of": [
            {
              "recognition": "And",
              "all_of": [
                "FeedHeader"
              ],
              "sub_name": "feedHeader"
            },
            "PersonalIcon"
          ],
          "box_index": 1
        }
      }
    },
    {
      "name": "profile_video_like",
      "label": "$profile_video_like_label",
      "description": "$profile_video_like_description",
      "entry": "OpenVisibleAuthor",
      "default_check": false,
      "pipeline_override": {
        "OpenVisibleAuthor": {
          "next": [
            "OpenAuthorVideo"
          ]
        },
        "OpenAuthorVideo": {
          "next": [
            "LikeVideo"
          ]
        }
      }
    }
  ],
  "option": {
    "interact_work_actions": {
      "type": "checkbox",
      "label": "$interact_work_actions_label",
      "description": "$interact_work_actions_description",
      "cases": [
        {
          "name": "like",
          "label": "$interact_case_like_work",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "likeWork": true
              }
            }
          }
        },
        {
          "name": "collect",
          "label": "$interact_case_collect_work",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "collectWork": true
              }
            }
          }
        },
        {
          "name": "comment",
          "label": "$interact_case_comment_work",
          "option": [
            "interact_comment_text"
          ],
          "pipeline_override": {}
        }
      ]
    },
    "interact_comment_text": {
      "type": "input",
      "label": "$interact_comment_text_label",
      "inputs": [
        {
          "name": "text",
          "label": "$interact_comment_text_field",
          "placeholder": "$interact_comment_text_placeholder",
          "default": ""
        }
      ],
      "pipeline_override": {
        "InteractWechatWork": {
          "custom_action_param": {
            "commentText": "{text}"
          }
        }
      }
    },
    "interact_comment_actions": {
      "type": "checkbox",
      "label": "$interact_comment_actions_label",
      "description": "$interact_comment_actions_description",
      "cases": [
        {
          "name": "like",
          "label": "$interact_case_like_comment",
          "option": [
            "interact_target_comment"
          ],
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "likeComment": true
              }
            }
          }
        },
        {
          "name": "reply",
          "label": "$interact_case_reply_comment",
          "option": [
            "interact_target_comment",
            "interact_reply_text"
          ],
          "pipeline_override": {}
        },
        {
          "name": "visit",
          "label": "$interact_case_visit_commenter",
          "option": [
            "interact_target_comment",
            "interact_commenter_actions"
          ],
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "touchCommenterProfile": {
                  "follow": false,
                  "likeFirstWork": false,
                  "collectFirstWork": false
                }
              }
            }
          }
        }
      ]
    },
    "interact_target_comment": {
      "type": "input",
      "label": "$interact_target_comment_label",
      "description": "$interact_target_comment_description",
      "inputs": [
        {
          "name": "nickname",
          "label": "$interact_target_nickname_field",
          "default": ""
        },
        {
          "name": "content",
          "label": "$interact_target_content_field",
          "default": ""
        }
      ],
      "pipeline_override": {
        "InteractWechatWork": {
          "custom_action_param": {
            "targetComment": {
              "nickname": "{nickname}",
              "content": "{content}"
            }
          }
        }
      }
    },
    "interact_reply_text": {
      "type": "input",
      "label": "$interact_reply_text_label",
      "inputs": [
        {
          "name": "text",
          "label": "$interact_reply_text_field",
          "placeholder": "$interact_reply_text_placeholder",
          "default": ""
        }
      ],
      "pipeline_override": {
        "InteractWechatWork": {
          "custom_action_param": {
            "replyText": "{text}"
          }
        }
      }
    },
    "interact_commenter_actions": {
      "type": "checkbox",
      "label": "$interact_commenter_actions_label",
      "description": "$interact_profile_actions_description",
      "default_case": [
        "follow",
        "like_first",
        "collect_first"
      ],
      "cases": [
        {
          "name": "follow",
          "label": "$interact_case_follow",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "touchCommenterProfile": {
                  "follow": true
                }
              }
            }
          }
        },
        {
          "name": "like_first",
          "label": "$interact_case_like_first",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "touchCommenterProfile": {
                  "likeFirstWork": true
                }
              }
            }
          }
        },
        {
          "name": "collect_first",
          "label": "$interact_case_collect_first",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "touchCommenterProfile": {
                  "collectFirstWork": true
                }
              }
            }
          }
        }
      ]
    },
    "interact_author_profile": {
      "type": "switch",
      "label": "$interact_author_profile_label",
      "description": "$interact_author_profile_description",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "option": [
            "interact_author_actions"
          ],
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "touchAuthorProfile": {
                  "follow": false,
                  "likeFirstWork": false,
                  "collectFirstWork": false
                }
              }
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "touchAuthorProfile": false
              }
            }
          }
        }
      ]
    },
    "interact_author_actions": {
      "type": "checkbox",
      "label": "$interact_author_actions_label",
      "description": "$interact_profile_actions_description",
      "default_case": [
        "follow",
        "like_first",
        "collect_first"
      ],
      "cases": [
        {
          "name": "follow",
          "label": "$interact_case_follow",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "touchAuthorProfile": {
                  "follow": true
                }
              }
            }
          }
        },
        {
          "name": "like_first",
          "label": "$interact_case_like_first",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "touchAuthorProfile": {
                  "likeFirstWork": true
                }
              }
            }
          }
        },
        {
          "name": "collect_first",
          "label": "$interact_case_collect_first",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "touchAuthorProfile": {
                  "collectFirstWork": true
                }
              }
            }
          }
        }
      ]
    },
    "interact_messages": {
      "type": "switch",
      "label": "$interact_messages_label",
      "description": "$interact_messages_description",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "option": [
            "interact_messages_like",
            "interact_messages_settings"
          ],
          "pipeline_override": {}
        },
        {
          "name": "No",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "inspectMessages": false
              }
            }
          }
        }
      ]
    },
    "interact_messages_like": {
      "type": "switch",
      "label": "$interact_messages_like_label",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "inspectMessages": {
                  "like": true
                }
              }
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "InteractWechatWork": {
              "custom_action_param": {
                "inspectMessages": {
                  "like": false
                }
              }
            }
          }
        }
      ]
    },
    "interact_messages_settings": {
      "type": "input",
      "label": "$interact_messages_settings_label",
      "inputs": [
        {
          "name": "count",
          "label": "$interact_messages_count_field",
          "default": "1",
          "pipeline_type": "int",
          "verify": "^([1-9]|10)$"
        },
        {
          "name": "reply",
          "label": "$interact_messages_reply_field",
          "description": "$interact_messages_reply_description",
          "default": ""
        }
      ],
      "pipeline_override": {
        "InteractWechatWork": {
          "custom_action_param": {
            "inspectMessages": {
              "maxMessages": "{count}",
              "replyText": "{reply}"
            }
          }
        }
      }
    },
    "interact_self_nickname": {
      "type": "input",
      "label": "$interact_self_nickname_label",
      "description": "$interact_self_nickname_description",
      "inputs": [
        {
          "name": "nickname",
          "label": "$interact_self_nickname_field",
          "default": ""
        }
      ],
      "pipeline_override": {
        "InteractWechatWork": {
          "custom_action_param": {
            "selfNickname": "{nickname}"
          }
        }
      }
    },
    "collect_comments_unlimited": {
      "type": "checkbox",
      "label": "$collect_comments_unlimited_label",
      "description": "$collect_comments_unlimited_description",
      "cases": [
        {
          "name": "unlimited",
          "label": "$collect_comments_unlimited_case",
          "pipeline_override": {
            "CollectWechatComments": {
              "custom_action_param": {
                "unlimited": true
              }
            }
          }
        }
      ]
    },
    "collect_comments_limits": {
      "type": "input",
      "label": "$collect_comments_limits_label",
      "description": "$collect_comments_limits_description",
      "inputs": [
        {
          "name": "max_pages",
          "label": "$collect_comments_max_pages",
          "default": "5",
          "verify": "^[1-9]\\d*$"
        },
        {
          "name": "max_reply_expansions",
          "label": "$collect_comments_max_reply_expansions",
          "default": "1",
          "verify": "^\\d+$"
        },
        {
          "name": "max_profiles",
          "label": "$collect_comments_max_profiles",
          "default": "2",
          "verify": "^\\d+$"
        }
      ],
      "pipeline_override": {
        "CollectWechatComments": {
          "custom_action_param": {
            "maxPages": "{max_pages}",
            "maxReplyExpansions": "{max_reply_expansions}",
            "maxProfiles": "{max_profiles}"
          }
        }
      }
    }
  },
  "preset": [
    {
      "name": "single_run",
      "label": "$preset_single",
      "task": [
        {
          "name": "like_and_visit"
        }
      ]
    },
    {
      "name": "compose_visit",
      "label": "$preset_compose_visit",
      "description": "$preset_compose_description",
      "task": [
        {
          "name": "open_wechat"
        },
        {
          "name": "open_discover"
        },
        {
          "name": "open_channels"
        },
        {
          "name": "like_video"
        },
        {
          "name": "open_author"
        },
        {
          "name": "return_to_feed"
        },
        {
          "name": "open_personal"
        }
      ]
    },
    {
      "name": "compose_profile_like",
      "label": "$preset_compose_profile",
      "description": "$preset_compose_description",
      "task": [
        {
          "name": "open_wechat"
        },
        {
          "name": "open_discover"
        },
        {
          "name": "open_channels"
        },
        {
          "name": "open_author"
        },
        {
          "name": "open_author_video"
        },
        {
          "name": "like_video"
        }
      ]
    }
  ],
  "agent": {
    "child_exec": "python3",
    "child_args": [
      "agent/main.py"
    ]
  }
}

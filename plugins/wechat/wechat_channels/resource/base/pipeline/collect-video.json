    "post_delay": 0
  },
  "BatchDiscoverTab": {
    "recognition": "And",
    "all_of": [
      {
        "recognition": "TemplateMatch",
        "template": "labels/discover-tab",
        "method": 5,
        "threshold": 0.88,
        "order_by": "Score",
        "roi": [
          0,
          -480,
          0,
          480
        ],
        "sub_name": "fastDiscoverTab"
      },
      {
        "recognition": "TemplateMatch",
        "template": "labels/contacts-tab",
        "method": 5,
        "threshold": 0.88,
        "order_by": "Score",
        "roi": "fastDiscoverTab",
        "roi_offset": [
          -270,

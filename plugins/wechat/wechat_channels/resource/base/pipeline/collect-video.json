  "InteractWechatWork": {
    "$comment": "Every action is off here; the interact_work task options build custom_action_param.",
    "recognition": "DirectHit",
    "action": "Custom",
    "custom_action": "InteractWechatWork",
    "custom_action_param": {},
    "pre_delay": 0,
    "post_delay": 0,
    "next": []
  },
  "BatchText": {
    "recognition": "OCR",
    "threshold": 0.55
  },
  "BatchProfileMore": {
    "recognition": "TemplateMatch",
    "template": [
      "profile-more.png",
      "profile-more-dark.png"
    ],
    "threshold": 0.88
  },
  "BatchBasicTitle": {
    "$comment": "Read-only readiness helper matches these labels on a 360px-wide frame.",
    "recognition": "TemplateMatch",
    "template": "labels/basic-info-title",
    "method": 5,
    "threshold": 0.88
  },
  "BatchChannelsId": {
    "$comment": "Read-only readiness helper matches these labels on a 360px-wide frame.",
    "recognition": "TemplateMatch",
    "template": "labels/channels-id",
    "method": 5,
    "threshold": 0.84
  },
  "BatchMessagesLikeTab": {
    "recognition": "And",
    "all_of": [
      {
        "recognition": "TemplateMatch",
        "template": [
          "messages-like.png",
          "messages-like-inactive.png"
        ],
        "threshold": 0.88,
        "roi": [
          120,
          60,
          400,
          100
        ]
      }
    ],
    "box_index": 0,
    "action": "DoNothing",
    "next": [],
    "timeout": 1,
    "pre_delay": 0,
    "post_delay": 0
  },
  "BatchMessagesCommentTab": {
    "recognition": "And",

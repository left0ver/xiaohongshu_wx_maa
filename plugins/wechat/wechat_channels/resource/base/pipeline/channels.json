  "RedThumb": {
    "$comment": "Color only proposes candidate regions; the unchanged shape/color template must still pass before a liked state is accepted.",
    "recognition": "And",
    "all_of": [
      {
        "recognition": "ColorMatch",
        "method": 4,
        "lower": [
          180,
          20,
          20
        ],
        "upper": [
          255,
          150,
          150
        ],
        "count": 200,
        "connected": true,
        "sub_name": "redThumbCandidates"
      },
      {
        "recognition": "TemplateMatch",
        "template": "thumb-red",
        "threshold": 0.88,
        "method": 10001,
        "order_by": "Score",
        "roi": "redThumbCandidates",
        "roi_offset": [
          -16,
          -16,
          32,
          32
        ]
      }
    ],
    "box_index": 1
  },

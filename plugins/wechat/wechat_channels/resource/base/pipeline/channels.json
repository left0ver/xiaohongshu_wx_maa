{
  "$comment": "shortcut: Chinese portrait layouts and sampled icon scales only; extend captures for changed WeChat layouts. Numeric ROIs restrict searches, never click targets. Shared operations use explicit task next overrides; recognitions remain guarded and each like action executes at most once. Template-first labels retain thresholded OCR fallback; MtaOcrFallback calls the original OCR tree only after template failure, avoiding eager batch OCR. Requires the bundled host callback. LikeCurrentVideo uses three taps at [360, 720] on the normalized 720px-short-side frame, followed by red-thumb verification; this point is a layout assumption.",
  "StartWeChat": {
    "action": "StartApp",
    "package": "com.tencent.mm",
    "next": [
      "OpenDiscover",
      "DetectOtherStartPages"
    ]
  },
  "OpenDiscover": {
    "action": "Click",
    "max_hit": 1,
    "next": [
      "OpenChannels"
    ],
    "recognition": "Or",
    "any_of": [
      {
        "recognition": "And",
        "all_of": [
          {
            "recognition": "TemplateMatch",
            "template": "labels/discover-tab",
            "method": 5,
            "threshold": 0.88,
            "order_by": "Score",
            "roi": [
              0,
              -480,
              0,
              480
            ],
            "sub_name": "fastDiscoverTab"
          },
          {
            "recognition": "TemplateMatch",
            "template": "labels/contacts-tab",
            "method": 5,
            "threshold": 0.88,
            "order_by": "Score",
            "roi": "fastDiscoverTab",
            "roi_offset": [
              -270,
              -16,
              220,
              32
            ]
          }
        ],
        "box_index": 0
      },
      {
        "recognition": "Custom",
        "custom_recognition": "MtaOcrFallback",
        "custom_recognition_param": {
          "type": "And",
          "param": {
            "all_of": [
              {
                "recognition": "OCR",
                "expected": "^发现$",
                "roi": [
                  0,
                  -480,
                  0,
                  480
                ],
                "sub_name": "mainDiscoverTab"
              },
              {
                "recognition": "OCR",
                "expected": "^通讯录$",
                "roi": "mainDiscoverTab",
                "roi_offset": [
                  -270,
                  -16,
                  220,
                  32
                ],
                "sub_name": "mainContactsTab"
              }
            ],
            "box_index": 0
          }
        }
      }
    ]
  },
  "OpenChannels": {
    "action": "Click",
    "max_hit": 1,
    "next": [
      "OpenAuthor",
      "LikeCurrentVideo"
    ],
    "recognition": "Or",

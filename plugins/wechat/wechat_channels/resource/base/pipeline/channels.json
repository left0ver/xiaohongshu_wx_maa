          {
            "recognition": "TemplateMatch",
            "template": "labels/channels-label",
            "method": 5,
            "threshold": 0.88,
            "order_by": "Score",
            "roi": [
              0,
              120,
              480,
              600
            ],
            "sub_name": "fastChannelsLabel"
          },
          {
            "recognition": "TemplateMatch",
            "template": "labels/discover-title",
            "method": 5,
            "threshold": 0.88,
            "order_by": "Score",
            "roi": [
              0,
              0,
              720,
              240
            ]
          }
        ],
        "box_index": 0
      },
      {
        "recognition": "Custom",
        "custom_recognition": "MtaOcrFallback",
        "custom_recognition_param": {
          "type": "And",
          "param": {
            "all_of": [
              {
                "recognition": "OCR",
                "expected": "^视频号$",
                "roi": [
                  0,
                  120,
                  480,
                  600
                ],
                "sub_name": "discoverChannelsLabel"
              },
              {
                "recognition": "OCR",
                "expected": "^发现$",
                "roi": [
                  0,
                  0,
                  0,
                  360
                ],
                "sub_name": "discoverPageTitle"
              }
            ]
          }
        }
      }
    ]
  },
  "LeavePersonal": {
    "recognition": "And",
    "all_of": [
      "PersonalPage"
    ],
    "action": "ClickKey",
    "key": 4,
    "max_hit": 1,
    "next": [
      "OpenAuthor",
      "LikeCurrentVideo"
    ]
  },
  "FeedReady": {
    "recognition": "And",
    "all_of": [
      {
        "recognition": "And",
        "all_of": [
          "FeedHeader"
        ],
        "sub_name": "feedHeader"
      },
      "PersonalIcon"
    ],
    "next": [
      "OpenAuthor",
      "LikeCurrentVideo"
    ]
  },
  "LikeCurrentVideo": {
    "recognition": "And",
    "all_of": [
      {
        "recognition": "And",
        "all_of": [
          "FeedHeader"
        ],
        "sub_name": "feedHeader"
      },
      "PersonalIcon",
      "WhiteThumb"
    ],
    "action": "Click",
    "max_hit": 1,
    "post_delay": 1200,
    "next": [
      "OpenAuthorAfterLike"
    ],
    "box_index": 2,
    "target": [
      360,
      720
    ],
    "repeat": 3,
    "repeat_delay": 80,
    "$comment": "Tap the same point in the video area three times (720px short-side coordinates). Keep the white-thumb recognition box for subsequent red-thumb verification."
  },
  "OpenAuthor": {
    "recognition": "And",
    "all_of": [
      "FeedHeader",
      {
        "recognition": "And",
        "all_of": [
          "RedThumb"

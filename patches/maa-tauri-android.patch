@@ -0,0 +1,66 @@
+use maa_framework::{custom::FnRecognition, resource::Resource, MaaResult};
+
+pub fn register(resource: &Resource) -> MaaResult<()> {
+    resource.register_custom_recognition(
+        "MtaPhysicalDisplay",
+        Box::new(FnRecognition::new(|_, _| {
+            (crate::runtime::active_display_id() == 0)
+                .then(|| (Default::default(), "{\"physicalDisplay\":true}".to_string()))
+        })),
+    )?;
+    resource.register_custom_recognition(
+        "MtaDiscoveryClipboard",
+        Box::new(FnRecognition::new(|_, _| {
+            #[cfg(target_os = "android")]
+            {
+                let text = match crate::diagnostics::bridge_string("discoveryClipboard") {
+                    Ok(text) => text,
+                    Err(error) => {
+                        log::warn!("Discovery clipboard bridge failed: {error}");
+                        return None;
+                    }
+                };
+                let value: serde_json::Value = serde_json::from_str(&text).ok()?;
+                if !valid_clip(&value) {
+                    return None;
+                }
+                Some((Default::default(), text))
+            }
+            #[cfg(not(target_os = "android"))]
+            None
+        })),
+    )
+}
+
+#[cfg(any(target_os = "android", test))]
+fn valid_clip(value: &serde_json::Value) -> bool {
+    value
+        .get("text")
+        .and_then(|v| v.as_str())
+        .is_some_and(|s| !s.is_empty() && s.len() <= 40000)
+        && value
+            .get("timestamp")
+            .and_then(|v| v.as_u64())
+            .is_some_and(|n| n > 0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn requires_text_and_clip_timestamp() {
+        assert!(valid_clip(
+            &json!({"text": "https://xhslink.com/a/abc", "timestamp": 1})
+        ));
+        for value in [
+            json!({}),
+            json!({"text": ""}),
+            json!({"text": "x", "timestamp": 0}),
+            json!({"text": "x", "timestamp": "1"}),
+        ] {
+            assert!(!valid_clip(&value));
+        }
+    }
+}

@@ -0,0 +1,35 @@
+package top.natsuu.mta.control
+
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import java.io.OutputStream
+import org.junit.Assert.*
+import org.junit.Test
+
+class FrameTransferTest {
+    @Test
+    fun writesTheCompleteFrameAndClosesThePipe() {
+        var closed = false
+        val output = object : ByteArrayOutputStream() {
+            override fun close() { closed = true; super.close() }
+        }
+        val frame = byteArrayOf(1, 2, 3, 4)
+        writeCapturedFrame(output, frame) { throw AssertionError(it) }
+        assertArrayEquals(frame, output.toByteArray())
+        assertTrue(closed)
+    }
+
+    @Test
+    fun readerDisconnectReportsFailureAndClosesWithoutEscapingTheThread() {
+        var closed = false
+        val failure = IOException("EPIPE")
+        var reported: IOException? = null
+        val output = object : OutputStream() {
+            override fun write(value: Int) { throw failure }
+            override fun close() { closed = true }
+        }
+        writeCapturedFrame(output, byteArrayOf(1)) { reported = it }
+        assertSame(failure, reported)
+        assertTrue(closed)
+    }
+}

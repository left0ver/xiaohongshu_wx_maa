diff --git a/src-tauri/src/lazy_recognition.rs b/src-tauri/src/lazy_recognition.rs
new file mode 100644
index 0000000..d091eb9
--- /dev/null
+++ b/src-tauri/src/lazy_recognition.rs
@@ -0,0 +1,93 @@
+use maa_framework::{custom::FnRecognition, resource::Resource, MaaResult};
+use serde::Deserialize;
+use serde_json::Value;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Recognition {
+    #[serde(rename = "type")]
+    kind: String,
+    param: Value,
+}
+
+// Only inline OCR trees are accepted: named/custom recognitions could recurse into this callback.
+fn valid_tree(kind: &str, param: &Value, depth: usize) -> bool {
+    if depth > 8 || !param.is_object() {
+        return false;
+    }
+    let children = match kind {
+        "OCR" => return true,
+        "And" => "all_of",
+        "Or" => "any_of",
+        _ => return false,
+    };
+    let Some(children) = param.get(children).and_then(Value::as_array) else {
+        return false;
+    };
+    !children.is_empty()
+        && children.len() <= 16
+        && children.iter().all(|child| {
+            child
+                .get("recognition")
+                .and_then(Value::as_str)
+                .is_some_and(|kind| valid_tree(kind, child, depth + 1))
+        })
+}
+
+pub fn register(resource: &Resource) -> MaaResult<()> {
+    resource.register_custom_recognition(
+        "MtaOcrFallback",
+        Box::new(FnRecognition::new(|context, args| {
+            let recognition: Recognition = serde_json::from_str(args.param).ok()?;
+            if !valid_tree(&recognition.kind, &recognition.param, 0) {
+                return None;
+            }
+            // Maa eagerly batches ordinary OCR candidates, even behind a successful template branch.
+            let result = context
+                .run_recognition_direct(
+                    &recognition.kind,
+                    &recognition.param.to_string(),
+                    args.image,
+                )
+                .ok()??;
+            result
+                .hit
+                .then(|| (result.box_rect, result.detail.to_string()))
+        })),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn accepts_ocr_and_relative_inline_checks() {
+        let param = json!({"all_of": [
+            {"recognition": "OCR", "expected": "发现", "sub_name": "tab"},
+            {"recognition": "OCR", "expected": "通讯录", "roi": "tab"}
+        ]});
+        assert!(valid_tree("And", &param, 0));
+        assert!(valid_tree("OCR", &json!({"expected": "推荐"}), 0));
+    }
+
+    #[test]
+    fn rejects_named_custom_malformed_and_overdeep_trees() {
+        for param in [
+            json!({"all_of": ["RecursiveNode"]}),
+            json!({"all_of": [{"recognition": "Custom"}]}),
+            json!({"all_of": []}),
+            json!({}),
+            json!(null),
+        ] {
+            assert!(!valid_tree("And", &param, 0));
+        }
+        assert!(!valid_tree("Custom", &json!({}), 0));
+        assert!(!valid_tree("OCR", &json!({}), 9));
+        assert!(
+            serde_json::from_str::<Recognition>(r#"{"type":"OCR","param":{},"extra":true}"#)
+                .is_err()
+        );
+    }
+}

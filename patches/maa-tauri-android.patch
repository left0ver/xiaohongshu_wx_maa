+package top.natsuu.mta.control
+
+import java.io.IOException
+import java.io.OutputStream
+
+internal fun writeCapturedFrame(output: OutputStream, frame: ByteArray, failed: (IOException) -> Unit) {
+    try {
+        output.use { it.write(frame) }
+    } catch (error: IOException) {
+        // A cancelled or disconnected reader must not crash the privileged service.
+        failed(error)
+    }
+}

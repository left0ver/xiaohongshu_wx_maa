+  "更新失败：": "wechatUpdateFailedDetail",
+};
+
+// 本地固定状态复用界面词典，服务端业务内容保持原文。
+export function localizeWechatMessage(
+  message: string,
+  language: AppLanguage,
+): string {
+  const text = message.replace(
+    /^java\.lang\.(?:IllegalArgumentException|IllegalStateException): /,
+    "",
+  );
+  const key = wechatMessageKeys[text];
+  if (key) return translate(language, key);
+
+  for (const [prefix, detailKey] of Object.entries(wechatDetailMessageKeys)) {
+    if (text.startsWith(prefix)) {
+      return translate(language, detailKey, {
+        detail: localizeWechatMessage(text.slice(prefix.length), language),
+      });
+    }
+  }
+
+  const uploaded = /^已上传视频 (\d+)，评论 (\d+)，用户资料 (\d+)$/.exec(text);
+  if (uploaded) {
+    return translate(language, "wechatUploadedCounts", {
+      videos: uploaded[1],
+      comments: uploaded[2],
+      profiles: uploaded[3],
+    });
+  }
+  const collected = /^采集结束：视频 (\d+)\/(\d+)，确认上传 (\d+)，待上传 (\d+)$/.exec(text);
+  if (collected) {
+    return translate(language, "wechatCollectionFinished", {
+      processed: collected[1],
+      requested: collected[2],
+      acknowledged: collected[3],
+      pending: collected[4],
+    });
+  }
+  return localizeDiagnostic(message, language);
+}

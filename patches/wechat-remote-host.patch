+const wechatDetailMessageKeys: Record<string, MessageKey> = {
+  "连接失败：": "wechatConnectionFailed",
+  "任务通信异常：": "wechatCommunicationFailed",
+  "诊断上传失败：": "wechatDiagnosticFailed",

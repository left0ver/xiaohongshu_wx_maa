+import { invoke } from "@tauri-apps/api/core";
+import { useEffect, useState } from "react";
+import { TextField } from "./ui/TextField";
+import { localizeWechatMessage, useTranslation } from "../lib/i18n";
+
+type RemoteState = { connected: boolean; receiving: boolean; configured: boolean; batteryWhitelisted: boolean; status: string; message: string; machine: string;
+  server: string; softwareCode: string; commandId: string; expiresAt: number;
+  release?: {updateAvailable: boolean; versionName: string}; messages: Array<{id: number; title: string; content: string}> };
+
+export function WechatRemoteCard() {
+  const { language, t } = useTranslation();
+  const [state, setState] = useState<RemoteState | null>(null);
+  const [server, setServer] = useState("https://api.joyfile.net/huoke");
+  const [software, setSoftware] = useState("qiaomen");
+  const [license, setLicense] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  useEffect(() => {
+    let active = true;
+    void invoke("wechat_account", {
+      config: {
+        notificationText: {
+          channel: t("wechatNotificationChannel"),
+          title: t("wechatNotificationTitle"),
+          connecting: t("wechatNotificationConnecting"),
+        },
+      },
+    }).catch(failure => {
+      if (active) setError(String(failure));
+    });
+    return () => {
+      active = false;
+    };
+  }, [t]);
+  useEffect(() => {
+    let active = true;
+    let initialized = false;
+    const refresh = async () => {
+      try {
+        const next = await invoke<RemoteState>("wechat_status");
+        if (active) {
+          if (!initialized) { setServer(next.server); setSoftware(next.softwareCode); initialized = true; }
+          setState(next);
+        }
+      } catch (failure) { if (active) setError(String(failure)); }
+    };
+    void refresh();
+    const timer = setInterval(() => void refresh(), 2000);
+    return () => { active = false; clearInterval(timer); };
+  }, []);
+  async function configure(disconnect = false) {
+    setBusy(true); setError("");
+    try {
+      const next = await invoke<RemoteState>("wechat_account", {config: {server, softwareCode: software, licenseKey: license,
+        disconnect, resume: !license.trim() && state?.configured}});
+      setState(next); setLicense("");
+    } catch (failure) { setError(String(failure)); }
+    finally { setBusy(false); }
+  }
+  return (
+    <section className="space-y-4 rounded-2xl border border-line bg-raised p-5">
+      <div className="flex items-center justify-between gap-3">
+        <h2 className="text-xl font-semibold">{t("wechatRemoteTitle")}</h2>
+        <span className="text-ink-muted">{state && localizeWechatMessage(state.status, language)}</span>
+      </div>
+      <TextField type="password" label={t("wechatLicense")} value={license} onValueChange={setLicense} disabled={busy || state?.receiving} />
+      <details><summary className="cursor-pointer text-ink-muted">{t("wechatServerSettings")}</summary>
+        <div className="mt-3 space-y-3">
+          <TextField label={t("wechatServer")} value={server} onValueChange={setServer} disabled={busy || state?.receiving} />
+          <TextField label={t("wechatSoftware")} value={software} onValueChange={setSoftware} disabled={busy || state?.receiving} />
+        </div>
+      </details>
+      <p className="text-ink-muted">{state?.message ? localizeWechatMessage(state.message, language) : t("wechatRemoteDescription")}</p>
+      {state && state.expiresAt > 0 && <p>{t("wechatValidUntil")} {new Date(state.expiresAt).toLocaleDateString(language)}</p>}
+      {state && !state.batteryWhitelisted && <button type="button" className="btn w-full"
+        onClick={() => { void invoke("request_battery_optimization_exemption").catch(failure => setError(String(failure))); }}>
+        {t("wechatBackgroundPermission")}</button>}
+      {state?.commandId && <p className="break-all text-sm text-ink-muted">{state.commandId}</p>}
+      {error && <p role="alert" className="text-error">{localizeWechatMessage(error, language)}</p>}
